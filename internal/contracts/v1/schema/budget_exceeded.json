{
  "$id": "urn:societas:1:budget_exceeded",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scope",
    "scope_id",
    "limit",
    "error"
  ],
  "properties": {
    "scope": {
      "$ref": "urn:societas:1:common#/$defs/scope"
    },
    "scope_id": {
      "type": "string"
    },
    "limit": {
      "type": "string",
      "pattern": "^max_[a-z_]+$"
    },
    "error": {
      "$ref": "urn:societas:1:error"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
